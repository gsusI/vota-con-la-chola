  "classes": {
    "tercero_a_tiempo": "Un órgano distinto del obligado puede obligar, anular o sustituir el acto, o la norma fija una consecuencia automática, y el efecto llega antes de que el incumplimiento se consume (o en 6 meses o menos si es continuado).",
    "tercero_tarde": "Un tercero puede anular u obligar, pero el remedio típico llega después de que el acto haya producido sus efectos o tarda más de 6 meses.",
    "buena_voluntad": "Nadie puede obligar ni sustituir: la única consecuencia es política (elecciones, censura, reproche) o una declaración sin efecto ejecutivo."
  },
  "episode_kinds": {
    "incumplimiento_declarado": "Un tribunal u órgano competente declaró que la regla se incumplió.",
    "plazo_vencido": "Un plazo fijado por la norma pasó sin que se cumpliera (mandato caducado, presupuesto no presentado).",
    "tension": "Uso en el límite de la regla, discutido por órganos oficiales, sin declaración de incumplimiento.",
    "remedio": "Un tercero actuó y la regla se hizo cumplir.",
    "aval": "Un tribunal u órgano competente avaló el acto discutido."
  },
