{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "review_status", "measures"],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "enum": ["resolved", "ignored", "pending"]
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "measure_title",
          "citizen_summary",
          "primary_vote_event_ids",
          "support_side",
          "evidence"
        ],
        "properties": {
          "measure_title": {
            "type": "string",
            "minLength": 1
          },
          "citizen_summary": {
            "type": "string",
            "minLength": 1
          },
          "primary_vote_event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "support_side": {
            "type": "string",
            "enum": ["yes", "no", "mixed", "unknown"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["quote", "doc_file"],
              "properties": {
                "quote": {
                  "type": "string"
                },
                "doc_file": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
