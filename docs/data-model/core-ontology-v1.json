{
  "schema_version": "core_ontology_v1",
  "updated_at": "2026-08-19",
  "status": "stable_vocabulary_experimental_physical_mappings",
  "source_of_truth": "docs/data-model/core-ontology-v1.md",
  "policy": {
    "official_records_only": true,
    "synthetic_or_mock_data_forbidden": true,
    "placeholder_records_forbidden": true,
    "implicit_fixture_fallback_forbidden": true,
    "official_public_domain_personal_information_retained": true,
    "private_or_secret_material_excluded": true,
    "derived_signals_are_not_corruption_findings": true,
    "causality_requires_separate_methodological_gate": true
  },
  "id_contract": {
    "public_id_format": "urn:vclc:<entity_type>:<uuidv5>",
    "source_scoped_components": [
      "entity_type",
      "source_id",
      "source_native_id",
      "source_scope"
    ],
    "local_primary_key_suffix": "_pk",
    "public_id_suffix": "_id",
    "person_name_alone_may_define_identity": false,
    "cross_source_resolution_requires_evidence": true,
    "old_ids_remain_resolvable_after_merge_or_split": true
  },
  "time_contract": {
    "instant_format": "ISO-8601-with-offset",
    "date_format": "YYYY-MM-DD",
    "required_observation_fields": [
      "observed_at",
      "source_snapshot_date"
    ],
    "lifecycle_fields": [
      "valid_from",
      "valid_to",
      "created_at",
      "updated_at",
      "superseded_at"
    ],
    "event_fields": [
      "occurred_at",
      "occurred_on",
      "occurred_from",
      "occurred_to"
    ],
    "publication_fields": [
      "published_at",
      "published_on",
      "effective_from",
      "effective_to",
      "fetched_at"
    ],
    "precision_values": [
      "instant",
      "day",
      "month",
      "year",
      "interval",
      "unknown"
    ]
  },
  "provenance_contract": {
    "required_fact_fields": [
      "source_id",
      "source_record_id_or_pk",
      "source_url_when_public",
      "source_snapshot_date",
      "observed_at",
      "content_sha256_or_cas_reference",
      "created_at",
      "updated_at"
    ],
    "required_derived_fields": [
      "method",
      "method_version",
      "evidence_id_or_links",
      "confidence_when_applicable",
      "review_status"
    ],
    "document_locator_fields": [
      "page",
      "section",
      "paragraph",
      "char_start",
      "char_end",
      "selector",
      "fragment_sha256"
    ],
    "raw_bytes_storage": "content_addressed_object_storage",
    "sqlite_role": "catalog_ids_foreign_keys_queues_indexes_and_navigation",
    "mass_fact_storage": "partitioned_parquet"
  },
  "unknown_states": [
    "known",
    "unknown",
    "not_applicable",
    "not_published",
    "not_observed",
    "withheld_by_source",
    "blocked",
    "disputed",
    "no_signal",
    "pending_review",
    "superseded"
  ],
