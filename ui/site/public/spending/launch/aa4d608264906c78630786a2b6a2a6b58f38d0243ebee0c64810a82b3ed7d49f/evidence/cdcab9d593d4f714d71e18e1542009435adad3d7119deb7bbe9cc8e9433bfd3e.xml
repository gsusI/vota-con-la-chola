                </ns4:ContractModificationLegalMonetaryTotal>
                <ns4:FinalLegalMonetaryTotal>
                    <ns2:TaxExclusiveAmount currencyID="EUR">68452.31</ns2:TaxExclusiveAmount>
                </ns4:FinalLegalMonetaryTotal>
