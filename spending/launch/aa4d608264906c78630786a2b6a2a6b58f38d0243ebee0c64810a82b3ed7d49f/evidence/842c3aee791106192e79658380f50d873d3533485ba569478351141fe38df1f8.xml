                        <ns2:AwardingCriteriaTypeCode listURI="http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc">OBJ</ns2:AwardingCriteriaTypeCode>
                        <ns2:Description>Otros criterios de carácter social</ns2:Description>
                        <ns2:Note>Compromiso de realización de, al menos, 8,00 horas de acciones de sensibilización y formación a la plantilla que ejecutará el contrato acerca de los derechos en materia de igualdad y conciliación reconocidos en la normativa vigente y convenio correspondiente.</ns2:Note>
                        <ns2:AwardingCriteriaSubTypeCode listURI="http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc">4</ns2:AwardingCriteriaSubTypeCode>
